                  "var jsonData = JSON.parse(responseBody);",
                  "var vm = jsonData.value; ",
                  "if (vm !== null && vm.length == 1) {",
                  "    // Found the VM by name, lets figure out its current state, and set the next request to be",
                  "    // called. Also set the {{vm}} environment variable to the vm value.",
                  "    postman.setEnvironmentVariable('vm', vm[0].vm);",
                  "    ",
                  "    if (vm[0].power_state === 'POWERED_ON') {",
                  "        postman.setNextRequest('Power off');",
                  "    } else {",
                  "        postman.setNextRequest('Power on');",
                  "    }",
