    {
      "name": "- Session",
      "item": [
        {
          "name": "Login to vCenter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "tests[\"Response time is less than 1000ms\"] = responseTime < 1000;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{vault:basic-auth}}"
              }
            ],
            "url": {
              "raw": "https://{{vc}}/rest/com/vmware/cis/session",
              "protocol": "https",
              "host": [
                "{{vc}}"
              ],
              "path": [
                "rest",
                "com",
                "vmware",
                "cis",
                "session"
              ]
            },
            "description": "Login to vCenter API and retrieve Session"
          },
          "response": []
        },
        {
          "name": "Get current session info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "tests[\"Response time is less than 1000ms\"] = responseTime < 1000;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://{{vc}}/rest/com/vmware/cis/session?~action=get",
              "protocol": "https",
              "host": [
                "{{vc}}"
              ],
              "path": [
                "rest",
                "com",
                "vmware",
                "cis",
                "session"
              ],
              "query": [
                {
                  "key": "~action",
